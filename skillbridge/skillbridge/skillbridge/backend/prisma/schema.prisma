generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(cuid())
  clerkUserId   String    @unique    
  name          String
  email         String    @unique
  role          Role
  institutionId String?
  createdAt     DateTime  @default(now())
}